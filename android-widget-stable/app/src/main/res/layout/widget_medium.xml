<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mijn dag" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/text" android:paddingBottom="10dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/btn_today" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Vandaag" android:textColor="@color/text" android:textStyle="bold" android:background="@drawable/button_secondary_bg" android:layout_marginEnd="4dp" />
        <TextView android:id="@+id/btn_food" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Eten &amp; boodschappen" android:textColor="@color/text" android:textStyle="bold" android:background="@drawable/button_secondary_bg" android:layout_marginStart="4dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/btn_projects" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Projecten" android:textColor="@color/text" android:textStyle="bold" android:background="@drawable/button_secondary_bg" android:layout_marginEnd="4dp" />
        <TextView android:id="@+id/btn_notes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Notities" android:textColor="@color/text" android:textStyle="bold" android:background="@drawable/button_secondary_bg" android:layout_marginStart="4dp" />
    </LinearLayout>
    <TextView android:id="@+id/btn_focus" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="Focus" android:textColor="@color/white" android:textStyle="bold" android:background="@drawable/button_bg" android:layout_marginTop="8dp" />
</LinearLayout>
