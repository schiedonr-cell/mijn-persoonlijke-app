<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grid_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="1dp"
    android:background="@drawable/widget_bg_outline">

    <LinearLayout
        android:id="@+id/grid_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/widget_bg">

        <LinearLayout
            android:id="@+id/grid_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/grid_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vandaag"
                android:textSize="24sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/grid_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="di 6 okt"
                android:textSize="13sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/grid_agenda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/button_secondary_bg_transparent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/grid_agenda_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_grid_agenda" />
                    <TextView android:id="@+id/grid_agenda_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="Agenda" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" />
                    <TextView android:id="@+id/grid_agenda_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:includeFontPadding="false" />
                </LinearLayout>
                <TextView android:id="@+id/grid_agenda_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_agenda_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_agenda_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/grid_tasks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/button_secondary_bg_transparent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/grid_tasks_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_grid_tasks" />
                    <TextView android:id="@+id/grid_tasks_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="Taken" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" />
                    <TextView android:id="@+id/grid_tasks_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:includeFontPadding="false" />
                </LinearLayout>
                <TextView android:id="@+id/grid_tasks_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_tasks_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_tasks_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_tasks_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/grid_routines"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/button_secondary_bg_transparent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/grid_routines_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_grid_routines" />
                    <TextView android:id="@+id/grid_routines_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="Routines" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" />
                    <TextView android:id="@+id/grid_routines_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:includeFontPadding="false" />
                </LinearLayout>
                <TextView android:id="@+id/grid_routines_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_routines_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_routines_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_routines_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/grid_household"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/button_secondary_bg_transparent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/grid_household_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_grid_house" />
                    <TextView android:id="@+id/grid_household_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="Huishouden" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" />
                    <TextView android:id="@+id/grid_household_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:includeFontPadding="false" />
                </LinearLayout>
                <TextView android:id="@+id/grid_household_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_household_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_household_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/grid_household_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
