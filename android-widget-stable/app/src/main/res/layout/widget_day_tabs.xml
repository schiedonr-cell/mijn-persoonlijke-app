<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="2dp">
    <TextView android:id="@+id/day_tab_today"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center"
        android:text="Vandaag" android:textSize="15sp" android:textStyle="bold"
        android:background="@drawable/widget_bg_dark"/>
    <TextView android:id="@+id/day_tab_tomorrow"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center"
        android:text="Morgen" android:textSize="15sp" android:textStyle="bold"
        android:background="@drawable/widget_bg_transparent"/>
</LinearLayout>
