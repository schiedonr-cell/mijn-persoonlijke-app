<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shortcut_row_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/row_focus_root"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="3dp"
        android:orientation="vertical"
        android:padding="1dp"
        android:background="@drawable/widget_bg_outline">
        <FrameLayout
            android:id="@+id/row_focus_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:background="@drawable/widget_bg">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView android:id="@+id/row_focus_icon_small" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_focus_target" android:scaleType="fitCenter" android:visibility="gone" />
                <ImageView android:id="@+id/row_focus_icon_medium" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_focus_target" android:scaleType="fitCenter" android:visibility="gone" />
                <ImageView android:id="@+id/row_focus_icon_large" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_focus_target" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/row_focus_icon_xlarge" android:layout_width="68dp" android:layout_height="68dp" android:src="@drawable/ic_focus_target" android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/row_focus_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Focus" android:textSize="17sp" android:textStyle="bold" android:includeFontPadding="false" android:gravity="center" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_food_root"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:orientation="vertical"
        android:padding="1dp"
        android:background="@drawable/widget_bg_outline">
        <FrameLayout
            android:id="@+id/row_food_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:background="@drawable/widget_bg">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView android:id="@+id/row_food_icon_small" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_food" android:scaleType="fitCenter" android:visibility="gone" />
                <ImageView android:id="@+id/row_food_icon_medium" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_food" android:scaleType="fitCenter" android:visibility="gone" />
                <ImageView android:id="@+id/row_food_icon_large" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_food" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/row_food_icon_xlarge" android:layout_width="68dp" android:layout_height="68dp" android:src="@drawable/ic_food" android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/row_food_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Eten" android:textSize="17sp" android:textStyle="bold" android:includeFontPadding="false" android:gravity="center" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_notes_root"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:orientation="vertical"
        android:padding="1dp"
        android:background="@drawable/widget_bg_outline">
        <FrameLayout
            android:id="@+id/row_notes_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:background="@drawable/widget_bg">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView android:id="@+id/row_notes_icon_small" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_note" android:scaleType="fitCenter" android:visibility="gone" />
                <ImageView android:id="@+id/row_notes_icon_medium" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_note" android:scaleType="fitCenter" android:visibility="gone" />
                <ImageView android:id="@+id/row_notes_icon_large" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_note" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/row_notes_icon_xlarge" android:layout_width="68dp" android:layout_height="68dp" android:src="@drawable/ic_note" android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/row_notes_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Notitie" android:textSize="17sp" android:textStyle="bold" android:includeFontPadding="false" android:gravity="center" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
