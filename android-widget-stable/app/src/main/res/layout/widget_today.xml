<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vandaag"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="@color/text" />

    <TextView
        android:id="@+id/today_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="Open Mijn dag om vandaag te laden"
        android:textSize="12sp"
        android:textColor="#6B7168" />

    <TextView android:id="@+id/today_row_1" style="@style/TodayRow" />
    <TextView android:id="@+id/today_row_2" style="@style/TodayRow" />
    <TextView android:id="@+id/today_row_3" style="@style/TodayRow" />
    <TextView android:id="@+id/today_row_4" style="@style/TodayRow" />
    <TextView android:id="@+id/today_row_5" style="@style/TodayRow" />
    <TextView android:id="@+id/today_row_6" style="@style/TodayRow" />
    <TextView android:id="@+id/today_row_7" style="@style/TodayRow" />

    <TextView
        android:id="@+id/today_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="Nog geen actueel overzicht."
        android:textSize="14sp"
        android:textColor="@color/text" />

    <TextView
        android:id="@+id/today_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text=""
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#45624D"
        android:visibility="gone" />
</LinearLayout>
