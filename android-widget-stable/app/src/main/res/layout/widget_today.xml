        </LinearLayout>
        <LinearLayout android:id="@+id/today_row_box_7" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/today_time_7" android:layout_width="64dp" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#45624D" android:maxLines="1" />
            <TextView android:id="@+id/today_row_7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textColor="@color/text" />
        </LinearLayout>

        <LinearLayout android:id="@+id/today_row_box_8" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/today_time_8" android:layout_width="64dp" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#45624D" android:maxLines="1" />
            <TextView android:id="@+id/today_row_8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textColor="@color/text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/today_row_box_9" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/today_time_9" android:layout_width="64dp" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#45624D" android:maxLines="1" />
            <TextView android:id="@+id/today_row_9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textColor="@color/text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/today_row_box_10" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/today_time_10" android:layout_width="64dp" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#45624D" android:maxLines="1" />
            <TextView android:id="@+id/today_row_10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textColor="@color/text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/today_row_box_11" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/today_time_11" android:layout_width="64dp" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#45624D" android:maxLines="1" />
            <TextView android:id="@+id/today_row_11" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textColor="@color/text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/today_row_box_12" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/today_time_12" android:layout_width="64dp" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#45624D" android:maxLines="1" />
            <TextView android:id="@+id/today_row_12" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" android:textColor="@color/text" />
        </LinearLayout>

        <TextView
            android:id="@+id/today_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Alles klaar voor vandaag."
            android:textSize="14sp"
            android:textColor="#6B7168"
            android:visibility="gone" />

        <TextView
            android:id="@+id/today_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text=""
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#45624D"
            android:visibility="gone" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
